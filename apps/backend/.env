# Forefront backend — server-side config read by Next.js + lib/backend.ts

# Port the dev/prod server binds to (Next reads PORT). Single source of truth.
PORT=9238

# Tailnet host the app reaches this server at (baked into the QR payload).
BACKEND_HOST=100.74.138.74

# Override the whole endpoint URL to use the MagicDNS name instead:
# BACKEND_ENDPOINT=http://macbook.hippo-tilapia.ts.net:9238

# Device bearer token the phone presents (the human). Defaults to test-token.
# BACKEND_TOKEN=test-token

# Agent key for the /agent/* producer surface (the DA). Strictly more privileged
# than BACKEND_TOKEN: authors agent/system messages + curates the deck. The device
# token cannot reach /agent/*. Change this in any shared deployment.
FOREFRONT_AGENT_TOKEN=dev-agent-token

# SQLite file backing chat threads, messages, and curated deck cards. Relative
# paths resolve against the repo root. The .data/ dir is gitignored.
FOREFRONT_DB_PATH=.data/forefront.db

# ── APNs (Apple Push) — the delivery leg (lib/apns.ts) ───────────────────────
# All UNSET below = APNs is not configured and `forefront push drain` is a safe
# no-op (records stay pending). Drop the three required values in and it lights
# up — no code change. Setup steps live in Docs/BACKEND_SERVER.md § APNs.
#
# REQUIRED to enable sending (until all three are set, sends no-op):
#   APNS_KEY_PATH — filesystem path to the .p8 Auth Key downloaded from the
#     Apple Developer portal (Certificates, IDs & Profiles → Keys). The .p8 is
#     a secret — keep it OUT of git (*.pem is gitignored; store it elsewhere).
#   APNS_KEY_ID   — the 10-char Key ID shown next to the key in the portal.
#   APNS_TEAM_ID  — your 10-char Apple Developer Team ID (top-right in the portal).
# APNS_KEY_PATH=/absolute/path/to/AuthKey_ABC123DEFG.p8
# APNS_KEY_ID=ABC123DEFG
# APNS_TEAM_ID=TEAM123456
#
# OPTIONAL:
#   APNS_BUNDLE_ID — the app's bundle id / APNs topic. Defaults below.
#   APNS_ENV       — `sandbox` (default; dev builds + TestFlight) or `production`
#                    (App Store builds). Picks api.sandbox.push.apple.com vs
#                    api.push.apple.com. A sandbox device token 403s on prod and
#                    vice-versa, so this must match how the app was built.
# APNS_BUNDLE_ID=com.trilliumsmith.forefront
# APNS_ENV=sandbox
