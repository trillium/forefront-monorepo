<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Forefront uses your camera to scan the server QR code.</string>
	<!-- App Transport Security: Forefront talks ONLY to tailnet-private endpoints
	     (Docs/BACKEND_CONTRACT.md §6), which are plaintext HTTP on Tailscale IP
	     literals like http://100.x.y.z:PORT. ATS blocks plaintext HTTP by default,
	     which silently fails every request (surfaced as "Offline"). The tailnet IS
	     the security boundary, so allow it. App-Review path: switch the QR payload
	     to the MagicDNS name and replace this with a scoped NSExceptionDomains
	     entry for `ts.net` (NSExceptionAllowsInsecureHTTPLoads + NSIncludesSubdomains). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
